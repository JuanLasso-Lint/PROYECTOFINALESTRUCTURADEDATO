<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.demo.viewController.ReservasViewController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Panel de Reservas y Disponibilidad" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Entrada:"/><DatePicker fx:id="dpEntrada" prefWidth="130"/>
        <Label text="Salida:"/><DatePicker fx:id="dpSalida" prefWidth="130"/>
        <Label text="Personas:"/><Spinner fx:id="spPersonas" prefWidth="75"/>
        <Label text="Orden:"/><ComboBox fx:id="cmbCriterio" prefWidth="140"/>
        <Button text="Buscar Disponibles" onAction="#onBuscarDisponibles" style="-fx-background-color: #007bff; -fx-text-fill: white;"/>
        <Button text="Grupo Grande (Backtracking)" onAction="#onAsignarGrupoGrande" style="-fx-background-color: #6f42c1; -fx-text-fill: white;"/>
    </HBox>
    <ListView fx:id="lvDisponibles" prefHeight="140"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="txtDocHuesped" promptText="Doc. Titular (ej. 115)" prefWidth="160"/>
        <TextField fx:id="txtDocsAcompanantes" promptText="Docs Acompañantes (ej. 220,330)" prefWidth="210"/>
        <ComboBox fx:id="cmbCanal" prefWidth="130"/>
        <Button text="Crear Reserva" onAction="#onConfirmarReserva" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Procesar Cola Externa (FIFO)" onAction="#onProcesarExterna"/>
        <Button text="Cancelar Vencidas (+24h)" onAction="#onCancelarVencidas"/>
    </HBox>
    <TextArea fx:id="txtLogReservas" VBox.vgrow="ALWAYS" editable="false" style="-fx-font-family: 'Consolas', monospace;"/>
</VBox>
