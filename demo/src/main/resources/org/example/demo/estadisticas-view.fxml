<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.pro_final_ed.viewController.EstadisticasViewController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Estadísticas y Reportes del Alojamiento" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Button text="Actualizar Reporte" onAction="#generarReporte" style="-fx-background-color: #1b263b; -fx-text-fill: white;"/>
    </HBox>
    <TextArea fx:id="txtReporteEstadisticas" VBox.vgrow="ALWAYS" editable="false" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13px;"/>
</VBox>
